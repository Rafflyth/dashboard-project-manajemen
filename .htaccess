<IfModule mod_rewrite.c>
    RewriteEngine On

    # Atur base path jika proyek berada di subfolder XAMPP
    # Ganti /dashboard-project-manajement/ jika diperlukan
    RewriteBase /dashboard-project-manajement/

    # Redirect root ke index.php
    RewriteRule ^$ index.php [L]

    # Biarkan file nyata dan direktori diakses langsung
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Arahkan semua request PHP yang tidak ada ke index.php
    RewriteRule ^(.+)$ index.php [QSA,L]
</IfModule>

<IfModule !mod_rewrite.c>
    # Jika Rewrite module tidak aktif, gunakan fallback biasa
    ErrorDocument 404 /dashboard-project-manajement/index.php
</IfModule>
